# GST Filing AI Assistant - Environment Variables
# Copy this to .env.local for local development

# =============================
# APPLICATION
# =============================
NEXT_PUBLIC_APP_NAME="GST Filing AI Assistant"
NEXT_PUBLIC_APP_URL=https://gst.rizipt.in

# =============================
# DATABASE (Supabase)
# =============================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================
# AI LAYER
# =============================
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# =============================
# GST PORTAL (NIC / GSTN APIs)
# =============================
GSTN_API_BASE_URL=https://api.gst.gov.in
GSTN_CLIENT_ID=your-client-id
GSTN_CLIENT_SECRET=your-client-secret

# =============================
# AUTHENTICATION
# =============================
NEXTAUTH_SECRET=your-32-char-secret
NEXTAUTH_URL=https://gst.rizipt.in
JWT_SECRET=your-jwt-secret

# =============================
# EMAIL (Notifications)
# =============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@rizipt.in
SMTP_PASSWORD=your-app-password

# =============================
# REDIS (Queue)
# =============================
REDIS_URL=redis://localhost:6379

# =============================
# ENCRYPTION
# =============================
AES_ENCRYPTION_KEY=your-32-byte-hex-key
